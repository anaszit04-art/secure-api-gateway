# Exemple uniquement : ne pas utiliser cette valeur en production.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=secure-api-gateway
JWT_AUDIENCE=secure-api-clients

# Redis / Rate limiting
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=secure-api-gateway
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_VERIFY_ON_STARTUP=false

# PostgreSQL
POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-a-random-local-password

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_VERIFY_ON_STARTUP=false
DATABASE_APPLICATION_NAME=secure-api-gateway

# Phase 6 - Observability
METRICS_ENABLED=true
METRICS_PORT=9100

# Phase 6 - Upstream resilience
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.1
UPSTREAM_CIRCUIT_FAILURE_THRESHOLD=3
UPSTREAM_CIRCUIT_RECOVERY_SECONDS=10
