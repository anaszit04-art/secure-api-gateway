# Secure API Gateway — configuration example
#
# Required secrets are intentionally empty.
# Fill them before starting Docker Compose.

# JWT authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=secure-api-gateway
JWT_AUDIENCE=secure-api-clients

# Internal upstream services
SERVICE_A_URL=http://service-a:8001
SERVICE_B_URL=http://service-b:8002

# Redis / rate limiting
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=secure-api-gateway
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Docker Compose forces startup verification to true
# for the production-like Gateway runtime.
REDIS_VERIFY_ON_STARTUP=false

# PostgreSQL
POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Docker Compose forces startup verification to true
# for the Gateway container.
DATABASE_VERIFY_ON_STARTUP=false
DATABASE_APPLICATION_NAME=secure-api-gateway

# DATABASE_URL is constructed by Docker Compose from
# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB.
# Direct non-Compose execution must provide DATABASE_URL.

# Observability
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9100

# Upstream resilience
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.1
UPSTREAM_CIRCUIT_FAILURE_THRESHOLD=3
UPSTREAM_CIRCUIT_RECOVERY_SECONDS=10
